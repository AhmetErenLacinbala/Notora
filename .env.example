NOTORA_VERSION=latest
NOTORA_AUTO_UPDATE=true
MAX_UPLOAD_MB=256
MAX_STORAGE_MB=2048

# Private dashboard. Leave blank to disable login. Never commit real credentials.
DASHBOARD_USERNAME=
# scrypt:<32-character hex salt>:<128-character hex digest>
DASHBOARD_PASSWORD_HASH=

# Optional private Cloudflare R2 quota gateway; credentials are server-only.
R2_GATEWAY_URL=
R2_GATEWAY_SECRET=
# Exact trusted reverse-proxy CIDR; do not trust arbitrary forwarding headers.
TRUST_PROXY=
